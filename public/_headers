# Hashed assets (JS/CSS/images from Vite) never change — cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# index.html and SPA routes must always revalidate so new deploys go live
# immediately (both client and Netlify CDN).
/*
  Cache-Control: public, max-age=0, must-revalidate